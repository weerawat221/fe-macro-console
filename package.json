{
  "name": "fe-macro-console",
  "version": "13.0.0",
  "description": "Field Engineer Macro Console — Electron rebuild with custom command editor",
  "main": "src/main/main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "sendinput-win32": "file:native/sendinput_win32",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "electron": "^43.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fieldops.macroconsole",
    "productName": "FE Macro Console",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "native/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/*.{md,map,ts}",
      "!node_modules/.bin"
    ],
    "asarUnpack": [
      "native/**/*"
    ],
    "extraResources": [
      {
        "from": "native/Win32Bridge.exe",
        "to": "native/Win32Bridge.exe"
      }
    ]
  }
}
